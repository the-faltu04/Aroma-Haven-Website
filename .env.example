NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_API_KEY=
SENTRY_DSN=

# Media storage: use filesystem only for local development. Production must use persistent storage or object storage.
MEDIA_STORAGE_PROVIDER=filesystem
MEDIA_LIBRARY_FROM_DATABASE=false
MEDIA_UPLOAD_DIR=./storage/media
MEDIA_PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=8
