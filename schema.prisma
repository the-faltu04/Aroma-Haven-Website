generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  OWNER
  MANAGER
  STAFF
}
enum FulfillmentType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}
enum OrderStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  PREPARING
  QUALITY_CHECK
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PaymentMethod {
  CASH_AT_CAFE
  CASH_ON_DELIVERY
  RAZORPAY_TEST
}
enum NotificationAudience {
  ADMIN
  CUSTOMER
}
enum CouponKind {
  PERCENTAGE
  FIXED
}

enum AdminPermission {
  MANAGE_ORDERS
  MANAGE_MENU
  MANAGE_CUSTOMERS
  MANAGE_COUPONS
  MODERATE_REVIEWS
  VIEW_ANALYTICS
  MANAGE_TABLES
  MANAGE_SETTINGS
  MANAGE_STAFF
  VIEW_FINANCIALS
  MANAGE_REFUNDS
  VIEW_AUDIT_LOG
}

model User {
  id              String         @id @default(cuid())
  role            UserRole       @default(CUSTOMER)
  displayName     String
  email           String?        @unique
  phone           String?        @unique
  passwordHash    String?
  isActive        Boolean        @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  identities      AuthIdentity[]
  sessions        Session[]
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  notifications   AppNotification[]
  auditEvents     AdminAuditLog[]
  uploadedMedia   MediaAsset[]    @relation("MediaUploadedBy")
  @@index([role, isActive])
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  recipient    String
  phone        String
  line1        String
  line2        String?
  locality     String
  city         String
  state        String
  postalCode   String
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model MenuCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  categoryId         String
  name               String
  slug               String              @unique
  shortDescription   String?
  description        String?
  pricePaise         Int
  imagePath          String?
  isPublished        Boolean             @default(false)
  isAvailable        Boolean             @default(false)
  isFeatured         Boolean             @default(false)
  preparationMinutes Int?
  dietaryLabels      String[]            @default([])
  allergenNotes      String?
  sortOrder          Int                 @default(0)
  archivedAt         DateTime?
  category           MenuCategory        @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  addOnGroups        ProductAddOnGroup[]
  orderItems         OrderItem[]
  reviews            Review[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([categoryId, isPublished, isAvailable])
  @@index([isFeatured, sortOrder])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  priceDeltaPaise Int      @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, isActive])
}

model AddOnGroup {
  id        String              @id @default(cuid())
  name      String
  minSelect Int                 @default(0)
  maxSelect Int                 @default(1)
  isActive  Boolean             @default(true)
  products  ProductAddOnGroup[]
  addOns    AddOn[]
}

model AddOn {
  id         String     @id @default(cuid())
  groupId    String
  name       String
  pricePaise Int        @default(0)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  group      AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model ProductAddOnGroup {
  productId String
  groupId   String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([productId, groupId])
}

model CafeTable {
  id              String   @id @default(cuid())
  tableNumber     Int      @unique
  label           String   @unique
  section         String?
  seatingCapacity Int      @default(2)
  isActive        Boolean  @default(true)
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique
  userId               String?
  customerName         String
  customerPhone        String
  customerEmail        String?
  fulfillmentType      FulfillmentType
  status               OrderStatus        @default(PENDING_REVIEW)
  paymentMethod        PaymentMethod?
  paymentStatus        PaymentStatus       @default(PENDING)
  tableId              String?
  deliveryAddress      Json?
  deliveryInstructions String?
  requestedFor         DateTime?
  subtotalPaise        Int
  discountPaise        Int                @default(0)
  cgstPaise            Int                @default(0)
  sgstPaise            Int                @default(0)
  igstPaise            Int                @default(0)
  deliveryFeePaise     Int                @default(0)
  tipPaise             Int                @default(0)
  totalPaise           Int
  currency             String             @default("INR")
  couponCode           String?
  customerNote         String?
  internalNote         String?
  acceptedAt           DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  table                CafeTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  statusHistory        OrderStatusEvent[]
  payments             Payment[]
  review               Review?
  couponRedemption     CouponRedemption?
  @@index([status, createdAt])
  @@index([fulfillmentType, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  productNameSnapshot String
  unitPricePaise      Int
  quantity            Int
  lineTotalPaise      Int
  selectedOptions     Json?
  customerNote        String?
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model OrderStatusEvent {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerOrderId   String?
  providerPaymentId String?       @unique
  idempotencyKey    String        @unique
  amountPaise       Int
  currency          String        @default("INR")
  testMode          Boolean       @default(true)
  providerStatus    String?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, status])
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  kind             CouponKind
  value            Int
  minOrderPaise    Int                @default(0)
  maxDiscountPaise Int?
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  isActive         Boolean            @default(false)
  redemptions      CouponRedemption[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  orderId       String   @unique
  userId        String?
  discountPaise Int
  createdAt     DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([couponId, userId])
}

model Review {
  id              String   @id @default(cuid())
  orderId         String   @unique
  productId       String?
  userId          String
  rating          Int
  title           String?
  body            String?
  isVerifiedOrder Boolean  @default(true)
  isPublished     Boolean  @default(false)
  moderatedAt     DateTime?
  moderationNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([productId, isPublished, createdAt])
}

model AppNotification {
  id        String               @id @default(cuid())
  audience  NotificationAudience
  userId    String?
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([audience, readAt, createdAt])
  @@index([userId, readAt, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model StoreSettings {
  id                     String   @id @default("default")
  storeName              String   @default("Aroma Haven Café")
  tagline                String   @default("Served With Love & Quality !!")
  phone                  String   @default("+91 9229310610")
  whatsapp               String   @default("+91 9229310610")
  publicEmail            String   @default("Anubhavrajput@aromahavencafe.com")
  city                   String   @default("Motihari")
  state                  String   @default("Bihar")
  country                String   @default("India")
  timezone               String   @default("Asia/Kolkata")
  onlineOrdering24x7     Boolean  @default(true)
  physicalHours          Json?
  orderAcceptanceMode    String   @default("MANUAL")
  deliveryFeePaise       Int      @default(4000)
  freeDeliveryAbovePaise Int      @default(49900)
  taxConfigurationStatus String   @default("PENDING_CONFIRMATION")
  restaurantTaxRateBps   Int?
  cgstRateBps            Int?
  sgstRateBps            Int?
  taxPricesInclusive     Boolean  @default(false)
  loyaltyRulesStatus     String   @default("NOT_CONFIGURED")
  razorpayTestEnabled    Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model RolePermission {
  id         String          @id @default(cuid())
  role       UserRole
  permission AdminPermission
  createdAt  DateTime        @default(now())
  @@unique([role, permission])
  @@index([role])
}


/// Uploaded image records. Storage is provider-neutral; objectKey is never a user-supplied filesystem path.
model MediaAsset {
  id               String          @id @default(cuid())
  storageProvider  String          @default("LOCAL")
  objectKey        String          @unique
  publicUrl        String
  originalFilename String
  contentType      String
  sizeBytes        Int
  width            Int?
  height           Int?
  altText          String?
  uploadedById     String?
  createdAt        DateTime        @default(now())
  uploader         User?           @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  assignedSlots    SiteMediaSlot[]
  @@index([createdAt])
  @@index([uploadedById, createdAt])
}

/// Stable site-wide image slots. Pages reference slot keys, so replacing media never requires page edits.
model SiteMediaSlot {
  key        String     @id
  title      String
  altText    String?
  assetId    String?
  focalX     Int        @default(50)
  focalY     Int        @default(50)
  updatedAt  DateTime   @updatedAt
  asset      MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  @@index([assetId])
}
